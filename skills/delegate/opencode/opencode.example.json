{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/mimo-v2.6-flash-free",
  "share": "disabled",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro (NVIDIA)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash (NVIDIA)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "minimaxai/minimax-m3.1-flash": {
          "name": "MiniMax M3.1 Flash (NVIDIA)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "mistralai/mistral-large-4-1t-a52b": {
          "name": "Mistral Large 4 (NVIDIA)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra (NVIDIA)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    }
  }
}